        "DATA_UNITS = {hemi: hemicycle_units(emergences, hemi) for hemi in HEMISPHERES}\n",
        "print(f\"north: {len(DATA_UNITS['north'])} hemicycles, south: {len(DATA_UNITS['south'])} hemicycles\")"
